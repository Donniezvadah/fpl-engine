.DS_Store
.idea/
.vscode/

# Node / Next.js
web/node_modules/
web/.next/
web/out/

# Generated site data — rebuilt from the API on every deploy, so committing it
# would just churn a 200KB blob and let a stale snapshot ship by accident.
web/public/data/
