# Copy to .env and fill in. .env is gitignored.

# Your FPL entry (team) ID — the number in your Points-page URL:
#   fantasy.premierleague.com/entry/1234567/event/1
# Leave 0 to run in draft mode (best squad from scratch, no team linked).
FPL_TEAM_ID=0

# Season to operate on. Derived from today's date when unset, so the engine
# rolls over each summer on its own. Override only to pin a specific season.
# FPL_SEASON=2026-27
